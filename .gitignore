# Every database and its SQLite sidecars stays local.
*.[dD][bB]
*.[dD][bB]-*
*.[sS][qQ][lL][iI][tT][eE]*

# Private statements, imports, exports, backups and generated files.
/data/
/raw/
/imports/
/exports/
/backups/
/private/
/auth/
/dist/
*.[cC][sS][vV]
*.[tT][sS][vV]
