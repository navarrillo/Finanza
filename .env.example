# Generate a local .env with: python3 scripts/setup.py --demo
# Empty values, documented placeholders, and low-entropy secrets are refused.
APP_USER=admin
APP_PASSWORD=
SESSION_SECRET=
# false for local HTTP; true behind an HTTPS reverse proxy.
# Strict-Transport-Security is sent only when this is true.
COOKIE_SECURE=false
DB_PATH=./data/demo.db
DB_DIRECTORY=./data
DB_FILENAME=demo.db
DEMO_MODE=true
# For HTTPS deployments, set the exact public origin without a path.
# PUBLIC_ORIGIN=https://finanzas.example.com
# Address of the reverse proxy as the app sees it. Never an asterisk.
# Unset here: Compose defaults to loopback. See the README reverse-proxy notes.
# FORWARDED_ALLOW_IPS=
